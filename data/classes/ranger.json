    {
      "id": "combat-instincts",
      "name": "Combat Instincts",
      "level": 3,
      "description": "At 3rd level, your sharpened instincts allow you to exploit openings in battle with speed and precision. Whenever you take the Attack action on your turn, your walking speed increases by 10 feet until the end of the turn. When you hit a creature with a weapon attack made as part of that action, you can expend one Instinct Die to use one of the following Combat Instinct options. You can use only one Combat Instinct option per turn.",
      "options": {
        "Guarded Instinct": "Roll your Instinct Die and add the number rolled to the damage of the attack. You also gain a bonus to your AC equal to the number rolled until the start of your next turn.",
        "Sweeping Instinct": "Roll your Instinct Die and add the number rolled to the damage of the attack. Another creature of your choice that you can see within 5 feet of you also takes damage equal to the number rolled.",
        "Pursuing Instinct": "Roll your Instinct Die and add the number rolled to the damage of the attack. You can also push the target up to 5 feet away from you, plus a number of feet equal to the number rolled on the Instinct Die. You can then immediately use your reaction to move up to your walking speed to an unoccupied space within 5 feet of the target."
      },
      "automation": {
        "support": "required",
        "hook": "class-feature:ranger:combat-instincts",
        "parameters": {
          "featureName": "Combat Instincts",
          "manualResolution": true
        },
        "combatInstincts": {
          "trigger": {
            "event": "attackActionOnTurn"
          },
          "movementBonus": {
            "movementType": "walk",
            "value": 10,
            "unit": "ft",
            "duration": "endOfTurn"
          },
          "spendOnHit": {
            "resource": "hunters-instinct",
            "amount": 1,
            "requiresWeaponHitFromTriggeringAction": true,
            "limitPerTurn": 1
          },
          "options": {
            "guarded": {
              "damageBonusFrom": "instinctDieRoll",
              "acBonusFrom": "instinctDieRoll",
              "acDuration": "untilStartOfNextTurn"
            },
            "sweeping": {
              "damageBonusFrom": "instinctDieRoll",
              "secondaryTarget": {
                "visible": true,
                "withinFeetOfSelf": 5
              },
              "secondaryDamageFrom": "instinctDieRoll"
            },
            "pursuing": {
              "damageBonusFrom": "instinctDieRoll",
              "push": {
                "baseFeet": 5,
                "additionalFeetFrom": "instinctDieRoll"
              },
              "reactionMove": {
                "upTo": "walkingSpeed",
                "destinationWithinFeetOfTarget": 5
              }
            }
          }
        }
      }
    },
    {
      "id": "deft-explorer",
      "name": "Deft Explorer",
      "level": 3,
      "description": "You are an unsurpassed explorer and survivor. You gain Canny at 3rd level, Roving at 6th level, and Tireless at 10th level.",
      "parts": [
        {
          "name": "Canny",
          "level": 3,
          "description": "Choose one skill you are proficient in. Your proficiency bonus is doubled for any ability check you make using the chosen skill. You can also speak, read, and write 2 additional languages of your choice."
        },
        {
          "name": "Roving",
          "level": 6,
          "description": "Your walking speed increases by 5 feet."
        },
        {
          "name": "Tireless",
          "level": 10,
          "description": "As an action, you can give yourself temporary hit points equal to 1d8 + your Wisdom modifier, minimum 1. You can use this action a number of times equal to your proficiency bonus and regain all expended uses when you finish a long rest. In addition, whenever you finish a short rest, your exhaustion level, if any, is decreased by 1."
        }
      ],
      "automation": {
        "support": "required",
        "hook": "class-feature:ranger:deft-explorer",
