    {
      "id": "hunters-instinct",
      "name": "Hunter's Instinct",
      "level": 1,
      "description": "At 1st level, your training, awareness, and experience have sharpened your instincts, allowing you to react when skill alone is not enough. When you attack with a weapon you are proficient with, you can use your Wisdom modifier, instead of Strength or Dexterity, for the attack and damage rolls. You have a number of Instinct Dice equal to your proficiency bonus. Your Instinct Die is a d4. When you make an attack roll, ability check, or saving throw, you can expend one Instinct Die, roll it, and add the number rolled to the result. You can choose to use your Instinct Die after you roll the d20, but before the DM determines whether the roll succeeds or fails. You can expend only one Instinct Die per roll. You regain all expended Instinct Dice when you finish a long rest. Your Instinct Die increases in size as you gain levels in this class. It becomes a d6 at 5th level, a d8 at 11th level, and a d10 at 17th level.",
      "resource": {
        "max": "proficiencyBonus",
        "recharge": "longRest",
        "dieByLevel": {
          "1": "d4",
          "5": "d6",
          "11": "d8",
          "17": "d10"
        }
      },
      "mechanics": {
        "weaponAttackAbilityOverride": "Wisdom",
        "weaponDamageAbilityOverride": "Wisdom",
        "requiresWeaponProficiency": true
      },
      "automation": {
        "resource": {
          "max": "proficiencyBonus",
          "recovery": "longRest",
          "dieByLevel": {
            "1": "d4",
            "5": "d6",
            "11": "d8",
            "17": "d10"
          }
        },
        "abilitySubstitution": {
          "ability": "wisdom",
          "for": [
            "weaponAttack",
            "weaponDamage"
          ],
          "requiresWeaponProficiency": true
        },
        "rollBonus": {
          "dieFrom": "hunters-instinct.resource",
          "appliesTo": [
            "attackRoll",
            "abilityCheck",
            "savingThrow"
          ],
          "timing": "afterD20BeforeOutcome",
          "maxPerRoll": 1
        }
      }
    },
    {
      "id": "ranger-conclave",
      "name": "Ranger Conclave",
      "level": 1,
      "description": "At 1st level, you choose to emulate the ideals and training of a ranger conclave. Your choice grants you features at 1st level, then again at 3rd, 7th, 11th, and 17th level.",
      "subclassFeatureLevels": [
        1,
        3,
        7,
        11,
        17
      ],
      "automation": {
        "subclassChoice": {
