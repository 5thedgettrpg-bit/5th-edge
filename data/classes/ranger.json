    {
      "id": "know-your-enemy",
      "name": "Know Your Enemy",
      "level": 2,
      "description": "Starting at 2nd level, you can quickly size up a creature. If you spend at least 1 minute observing or interacting with a creature outside combat, choose two of the following characteristics: Strength score, Dexterity score, Constitution score, Armor Class, current hit points, total class levels if any, or Ranger class levels if any. For each characteristic you choose, the DM tells you whether the creature's value is higher than, lower than, or equal to yours.",
      "activation": "1 minute outside combat",
      "mechanics": {
        "requiresOutsideCombat": true,
        "observationOrInteractionMinutes": 1,
        "choose": 2,
        "characteristics": [
          "Strength score",
          "Dexterity score",
          "Constitution score",
          "Armor Class",
          "Current hit points",
          "Total class levels, if any",
          "Ranger class levels, if any"
