  "features": [
    {
      "id": "primal-die",
      "name": "Primal Die",
      "level": 1,
      "type": "classScaling",
      "description": "Your Primal Die represents the growing strength of your primal power. Its size is shown in the Primal Die column of the Barbarian table. The Primal Die has no effect on its own. A Barbarian or Primal Path feature tells you when the die is used and what effect it has.",
      "automation": {
        "exposeResource": "primalDie"
      }
    },
    {
      "id": "rage",
      "name": "Rage",
      "level": 1,
      "type": "active",
      "activation": {
        "type": "bonusAction"
      },
      "duration": {
        "value": 1,
        "unit": "minute"
      },
      "resource": "rage",
      "description": "On your turn, you can enter a rage as a bonus action. While raging, you have advantage on Strength checks and Strength saving throws, gain your Rage Damage bonus on melee weapon attacks using Strength, and gain resistance to bludgeoning, piercing, and slashing damage. You cannot cast spells or concentrate on them while raging. Rage lasts for 1 minute. It ends early if you are incapacitated or if you choose to end it as a bonus action.",
      "automation": {
        "toggle": {
          "id": "raging",
          "label": "Rage",
          "effects": [
            {
              "type": "advantage",
              "check": "strength"
            },
            {
              "type": "advantage",
              "savingThrow": "strength"
            },
            {
              "type": "damageBonus",
              "appliesTo": "meleeWeaponAttack",
              "requiresAbility": "strength",
              "valueFrom": "progression.rageDamage"
            },
            {
              "type": "resistance",
              "damageTypes": [
                "bludgeoning",
                "piercing",
                "slashing"
              ]
            },
            {
              "type": "blockSpellcasting"
            },
            {
              "type": "blockConcentration"
            }
          ],
          "endsOn": [
            {
              "condition": "incapacitated"
            },
            {
              "manual": true,
              "activation": "bonusAction"
            }
          ]
        }
      }
    },
    {
      "id": "gritty-defense",
      "name": "Gritty Defense",
      "level": 1,
      "type": "passive",
      "description": "While you aren't wearing heavy armor, you can use your Constitution modifier instead of your Dexterity modifier when calculating your Armor Class. If you aren't wearing armor, your Armor Class equals 11 + your Constitution modifier + your proficiency bonus. If you are wearing light or medium armor, any limit the armor places on the Dexterity modifier you can add to your Armor Class instead applies to your Constitution modifier. You can use a shield and still gain these benefits.",
      "automation": {
        "armorClass": {
          "blockedByArmorCategory": "heavy",
          "abilitySubstitution": {
            "replace": "dexterity",
            "with": "constitution",
            "for": "armorClass"
          },
          "unarmoredFormula": "11 + CON + PB",
          "carryArmorDexCapToSubstituteAbility": true,
          "allowShield": true
        }
      }
    },
    {
      "id": "primal-path",
      "name": "Primal Path",
      "level": 1,
      "type": "subclassChoice",
      "description": "At 1st level, you choose a Primal Path that shapes the nature of your rage and the source of your primal power. Your Primal Path grants you a feature at 1st level and additional features at 3rd, 7th, 11th, and 17th level.",
      "automation": {
        "chooseSubclass": true,
        "subclassFeatureLevels": [
          1,
          3,
          7,
          11,
          17
        ]
      }
    },
    {
      "id": "reckless-attack",
      "name": "Reckless Attack",
      "level": 2,
      "type": "active",
      "description": "When you make your first attack on your turn, you can decide to attack recklessly. Doing so gives you advantage on melee weapon attack rolls using Strength during that turn, but attack rolls against you have advantage until the start of your next turn.",
      "automation": {
        "toggle": {
          "id": "recklessAttack",
          "label": "Reckless Attack",
          "trigger": "firstAttackOnTurn",
          "effects": [
            {
              "type": "advantage",
              "attack": "meleeWeaponAttack",
              "requiresAbility": "strength",
              "duration": "currentTurn"
            },
            {
              "type": "grantAttackersAdvantage",
              "duration": "untilStartOfNextTurn"
            }
          ]
        }
      }
    },
    {
      "id": "physically-imposing",
      "name": "Physically Imposing",
      "level": 2,
      "type": "passive",
      "description": "At 2nd level, you gain proficiency in the Intimidation skill. If you are already proficient in Intimidation, you gain proficiency in another skill of your choice from the barbarian skill list. In addition, you can use Strength in place of Charisma when making an Intimidation check.",
      "automation": {
        "grantProficiencies": [
          "Intimidation"
        ],
        "alreadyProficientFallback": {
          "choose": 1,
          "from": "classSkillList"
        },
        "skillAbilityOverride": {
          "Intimidation": "Strength"
        },
        "defaultAbility": "Charisma"
      }
    },
    {
      "id": "danger-sense",
      "name": "Danger Sense",
      "level": 3,
      "type": "passive",
      "description": "At 3rd level, you gain an uncanny sense of when things nearby are not as they should be. You have advantage on Dexterity saving throws against effects that you can see, such as traps and spells. You do not gain this benefit while you are blinded, deafened, or incapacitated.",
      "automation": {
        "savingThrowAdvantage": {
          "ability": "dexterity",
          "requiresEffectVisible": true,
          "disabledByConditions": [
            "blinded",
            "deafened",
            "incapacitated"
          ]
        }
      }
    },
    {
      "id": "brutal-critical",
      "name": "Brutal Critical",
      "level": 3,
      "type": "passive",
      "description": "At 3rd level, when you score a critical hit with a melee weapon attack, you can roll one of the weapon's damage dice one additional time and add it to the extra damage of the critical hit. The number of additional weapon damage dice increases to two at 9th level and three at 17th level.",
      "automation": {
        "trigger": {
          "event": "criticalHit",
          "attackType": "meleeWeaponAttack"
        },
        "extraWeaponDamageDiceByLevel": {
          "3": 1,
          "9": 2,
          "17": 3
        },
        "addTo": "criticalHitExtraDamage"
      }
    },
    {
      "id": "ability-score-improvement",
      "name": "Ability Score Improvement",
      "levels": [
        4,
        8,
        12,
        16,
        19
      ],
      "type": "builderChoice",
      "repeatable": true,
      "description": "Increase one ability score by 2, increase two ability scores by 1, or choose a feat for which you qualify if feats are allowed. You can't increase an ability score above 20 using this feature unless another feature increases that maximum.",
      "automation": {
        "builder": {
          "choice": "asiOrFeat",
          "defaultAbilityMaximum": 20
        }
      }
    },
    {
      "id": "extra-attack",
      "name": "Extra Attack",
      "level": 5,
      "type": "passive",
      "description": "You can attack twice, instead of once, whenever you take the Attack action on your turn.",
      "automation": {
        "attackActionCount": 2
      }
    },
    {
      "id": "fast-movement",
      "name": "Fast Movement",
      "level": 6,
      "type": "passive",
      "description": "Starting at 6th level, your speed increases by 10 feet while you are not wearing heavy armor.",
      "automation": {
        "speedModifier": {
          "movementType": "walk",
          "value": 10,
          "unit": "ft",
          "blockedByArmorCategory": "heavy"
        }
      }
    },
    {
      "id": "primal-champion",
      "name": "Primal Champion",
      "levels": [
        6,
        10,
        14
      ],
      "type": "passive",
      "repeatable": true,
      "description": "At 6th level, your Strength and Constitution scores each increase by 2 and their maximums become 22. At 10th level, both scores increase by 2 again and their maximums become 24. At 14th level, both scores increase by 2 again and their maximums become 26. These increases can raise your Strength and Constitution scores above 20.",
      "automation": {
        "steps": [
          {
            "level": 6,
            "abilityIncreases": {
              "strength": 2,
              "constitution": 2
            },
            "abilityMaximums": {
              "strength": 22,
              "constitution": 22
            }
          },
          {
            "level": 10,
            "abilityIncreases": {
              "strength": 2,
              "constitution": 2
            },
            "abilityMaximums": {
              "strength": 24,
              "constitution": 24
            }
          },
          {
            "level": 14,
            "abilityIncreases": {
              "strength": 2,
              "constitution": 2
            },
            "abilityMaximums": {
              "strength": 26,
              "constitution": 26
            }
          }
        ]
      }
    },
    {
      "id": "indomitable-might",
      "name": "Indomitable Might",
      "level": 9,
      "type": "passive",
      "description": "If your total for a Strength check is less than your Strength score, you can use your Strength score in place of the total.",
      "automation": {
        "minimumCheckTotal": {
          "ability": "strength",
          "minimumFrom": "abilityScore.strength"
        }
      }
    },
    {
      "id": "dauntless",
      "name": "Dauntless",
      "level": 13,
      "type": "passive",
      "description": "At 13th level, you have advantage on saving throws and ability checks you make to avoid or end the frightened or charmed condition. In addition, at the start of your turn, you can end the frightened or charmed condition on yourself. You can end one of these conditions this way a number of times equal to your proficiency bonus, and you regain all expended uses when you finish a long rest.",
      "resource": {
        "max": "proficiencyBonus",
        "recharge": "longRest"
      },
      "automation": {
        "advantage": {
          "appliesTo": [
            "avoidFrightened",
            "endFrightened",
            "avoidCharmed",
            "endCharmed"
          ]
        },
        "startOfTurn": {
          "optional": true,
          "endOneCondition": [
            "frightened",
            "charmed"
          ],
          "spendResource": "dauntless"
        }
      }
    },
    {
      "id": "persistent-rage",
      "name": "Persistent Rage",
      "level": 15,
      "type": "passive",
      "description": "Beginning at 15th level, your rage is so fierce that it ends early only if you are incapacitated or if you choose to end it as a bonus action.",
      "automation": {
        "modifyFeature": "rage",
        "preserveEndConditions": [
          "incapacitated",
          "manualBonusAction"
        ]
      }
    },
    {
      "id": "relentless-rage",
      "name": "Relentless Rage",
      "level": 18,
      "type": "reactionlessTrigger",
      "description": "If you drop to 0 hit points while raging and don't die outright, you can make a DC 10 Constitution saving throw. On a success, you drop to 1 hit point instead. Each time you use this feature after the first, the DC increases by 5. When you finish a short or long rest, the DC resets to 10.",
      "automation": {
        "trigger": {
          "event": "hpReducedToZero",
          "requiresState": "raging",
          "requiresNotDeadOutright": true
        },
        "savingThrow": {
          "ability": "constitution",
          "dcFromResource": "relentlessRageDC"
        },
        "onSuccess": {
          "setHP": 1
        },
        "afterUse": {
          "incrementResource": "relentlessRageDC"
        }
      }
    },
    {
      "id": "endless-rage",
      "name": "Endless Rage",
      "level": 20,
      "type": "passive",
      "description": "Your Strength and Constitution scores each increase by 4, and the maximum for both scores becomes 30. In addition, you can rage an unlimited number of times.",
      "automation": {
        "abilityIncreases": {
          "strength": 4,
          "constitution": 4
        },
        "abilityMaximums": {
          "strength": 30,
          "constitution": 30
        },
        "modifyResource": {
          "resource": "rage",
          "uses": "unlimited"
        }
      }
    }
  ]
}
