{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/race/triton",
      "destination": "/race/merfolk",
      "permanent": true
    },
    {
      "source": "/races/triton",
      "destination": "/race/merfolk",
      "permanent": true
    },
    {
      "source": "/race/tortle",
      "destination": "/race/chelonian",
      "permanent": true
    },
    {
      "source": "/races/tortle",
      "destination": "/race/chelonian",
      "permanent": true
    },
    {
      "source": "/race/locathah",
      "destination": "/race/icthyan",
      "permanent": true
    },
    {
      "source": "/races/locathah",
      "destination": "/race/icthyan",
      "permanent": true
    },
    {
      "source": "/race/bullywug",
      "destination": "/race/dendro",
      "permanent": true
    },
    {
      "source": "/races/bullywug",
      "destination": "/race/dendro",
      "permanent": true
    },
    {
      "source": "/species/:path*",
      "destination": "/race/:path*",
      "permanent": true
    },
    {
      "source": "/races/:path*",
      "destination": "/race/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/race",
      "destination": "/races"
    },
    {
      "source": "/race/:race",
      "destination": "/races/:race"
    },
    {
      "source": "/race/:race/:variant",
      "destination": "/races/:race"
    }
  ],
  "headers": [
    {
      "source": "/assets/css/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/js/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/races/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
